DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
POINT_CHANNEL_ID=
# Fallback channel boss (dipakai kalau guild belum di-set lewat /boss-channel).
# Tiap server bisa punya channel boss sendiri via command admin /boss-channel.
BOSS_CHANNEL_ID=
LOG_LEVEL=info

# Role ID yang membernya di-DM tiap ada klaim manual baru di /poruv-shop
# (Owocash, e-wallet, custom role). Comma-separated kalau lebih dari satu
# role. Kosongkan kalau tidak mau ada notifikasi DM.
ADMIN_ROLE_IDS=

# ── Fitur AI (/ai-ask) ────────────────────────────────────────
# Pengaturan rasa/persona ada di src/config/ai.js
# Urutan pemakaian: Groq -> Google AI Studio #1 -> Google AI Studio #2
# Provider yang kuncinya kosong otomatis dilewati.

# 1) Groq (utama) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 2) Google AI Studio kunci pertama — https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=
# 3) Google AI Studio kunci kedua (cadangan, akun/project lain)
GOOGLE_AI_API_KEY_2=
GOOGLE_AI_MODEL=gemini-2.0-flash
