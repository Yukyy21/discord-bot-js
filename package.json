{
  "name": "discord-bot",
  "version": "1.0.0",
  "description": "Bot Discord: ekonomi, poin otomatis dari chat & voice, dan kartu profil",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "deploy": "node scripts/deploy-commands.js",
    "backup": "node scripts/backup-db.js",
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.js\" \"scripts/**/*.js\" \"test/**/*.js\""
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.7",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3"
  }
}
